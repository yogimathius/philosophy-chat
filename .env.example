# OpenAI API Configuration
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI Organization ID
# VITE_OPENAI_ORG_ID=your_org_id_here

# Optional: Custom OpenAI Base URL (for Azure or custom endpoints)
# VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# Application Configuration
VITE_APP_NAME=Philosophy Chat
VITE_APP_VERSION=1.0.0

# Development settings
NODE_ENV=development

# Note: In production, API calls should go through your backend
# for security. This direct browser connection is for development only.