# Database
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/philosophy_chat
TEST_DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/philosophy_chat_test

# AI APIs
OPENAI_API_KEY=sk-proj-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Authentication
SECRET_KEY=your-secret-key-here-minimum-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
APP_NAME="Philosophy Chat API"
VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Hugging Face
HF_TOKEN=hf_your-hugging-face-token

# Redis (optional - for caching)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=INFO